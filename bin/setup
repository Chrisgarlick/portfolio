#!/usr/bin/env bash
# Gets a fresh clone ready to work on: the composer and npm packages, a .env
# (./up puts the real one back from the vault first), and on a Mac, Herd
# serving it at http://portfolio.test on PHP 8.3 (the server's version). Never
# starts a server. Safe to run again.
set -euo pipefail
cd "$(dirname "$0")/.."

need() { command -v "$1" >/dev/null 2>&1 || { echo "bin/setup: $1 isn't installed. $2" >&2; exit 1; }; }
if [ "$(uname -s)" = Darwin ]; then
  need php "Install Herd (https://herd.laravel.com), which brings PHP and Composer"
  need composer "It comes with Herd"
else
  need php "Install PHP 8.3: sudo add-apt-repository ppa:ondrej/php && sudo apt install php8.3-cli php8.3-{pgsql,mbstring,xml,curl,zip,gd,intl,bcmath}"
  need composer "brew install composer, or https://getcomposer.org/download/"
fi
need node "Install Node.js (Herd's, or brew install node)"
need npm "It comes with Node.js"
php -r 'exit(PHP_VERSION_ID >= 80300 ? 0 : 1);' || { echo "bin/setup: the site needs PHP 8.3+ (this is $(php -r 'echo PHP_VERSION;'))" >&2; exit 1; }
command -v docker >/dev/null 2>&1 || echo "bin/setup: note: bin/dev-db (the Postgres the site and tests use) needs Docker Desktop."

# Only on a fresh clone: an install would swap bin/link-cms's symlink to ~/dev/chris/cg-cms for the locked copy.
[ -d vendor ] || composer install --no-interaction
if [ node_modules/.package-lock.json -nt package-lock.json ]; then echo "node_modules is up to date"; else npm ci --no-audit --no-fund; fi
if [ ! -f .env ]; then cp .env.example .env; php artisan key:generate --no-interaction; fi

if command -v herd >/dev/null 2>&1; then
  herd links 2>/dev/null | grep -q " $(pwd) " || herd link portfolio
  herd isolated 2>/dev/null | grep -q 'portfolio.test' || herd isolate 8.3
  where="http://portfolio.test"
else
  where="php artisan serve"
fi
echo "Ready. bin/dev-db for the database (Docker), then $where. bin/link-cms runs the site on ~/dev/chris/cg-cms."
