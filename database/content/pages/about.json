            "column2_cta_label": "WordPress development",
            "column2_tint": "blue",
            "column3_heading": "AI",
            "column3_body": "Anthropic Claude, with structured outputs, versioned prompts and logging built in. UK and EU regions where data residency matters.",
            "column3_url": "/services/ai",
            "column3_cta_label": "AI implementation",
            "column3_tint": "violet",
            "column4_heading": "Integrations",
            "column4_body": "Whatever your team already uses: Microsoft 365, Google Workspace, Xero, HubSpot, Notion and the rest. Direct API work, not no-code glue."
        }
    },
    {
        "type": "cta",
