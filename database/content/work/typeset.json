        "eyebrow": "Case study 04 · Typeset, my product",
        "title": "PRINT-QUALITY PDFS\n*from plain text.*",
        "title_size": "large",
        "heading_level": "1",
        "lede": "My Rust service that turns Markdown or structured content into branded PDFs: proposals, scopes, audit reports and guides. It makes the planning PDFs and proposals I send."
      }
    },
