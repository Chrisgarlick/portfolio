# chrisgarlick.com production environment. Copied to /var/www/site/.env
# by provision.sh. Values marked CHANGE must be filled in before the first deploy.
# Never committed with real values.

APP_NAME="Chris Garlick"
APP_ENV=production
# Leave empty: the first site-deploy generates it.
APP_KEY=
APP_DEBUG=false
APP_URL=https://chrisgarlick.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=site
DB_USERNAME=site
DB_PASSWORD=                    # CHANGE: from /root/site-db-password

# The Kritano database, read once by site:import-legacy.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=5432
LEGACY_DB_DATABASE=cms
LEGACY_DB_USERNAME=site
LEGACY_DB_PASSWORD=             # CHANGE: same as DB_PASSWORD (provision.sh grants it read access)

# 1GB box: no Redis. File cache with version-stamped keys, database queue,
# sessions on disk for the admin only (plan section 9.2).
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true

# Mail: Resend over SMTP. Reuse the live RESEND_API_KEY as the password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=                  # CHANGE: the live RESEND_API_KEY
MAIL_FROM_ADDRESS=chrisgarlick@kritano.com
MAIL_FROM_NAME="Chris Garlick"
CONTACT_EMAIL=                  # CHANGE: the live CONTACT_EMAIL

CG_SITE_DOMAIN=https://chrisgarlick.com
CG_PAGE_CACHE_ENABLED=true
CG_PAGE_CACHE_PATH=page-cache
CG_CDN_DRIVER=null              # cloudflare once DNS moves (plan open question 5)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Reused from the live box's .env.
TYPESET_API_URL=https://typeset.chrisgarlick.com
TYPESET_API_KEY=                # CHANGE: the live TYPESET_API_KEY
KRITANO_API=                    # CHANGE: the live KRITANO_API
GTM_ID=GTM-N6FD4K8Z
