# The queue worker: media variants, mail, cache warming, SEO files, audits.
# One process with its own memory ceiling, so a bad image kills a job, not the
# box. Restarted by `artisan queue:restart` on every deploy. Plan section 9.2.
[Unit]
Description=chrisgarlick.com queue worker
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/site
ExecStart=/usr/bin/php -d memory_limit=96M /var/www/site/artisan queue:work --sleep=3 --tries=2 --max-jobs=100 --max-time=1800
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
