# One run of Laravel's scheduler: nightly SEO audit, daily cache prune,
# quarterly GDPR sweep. Fired every minute by site-scheduler.timer.
[Unit]
Description=chrisgarlick.com scheduler

[Service]
Type=oneshot
WorkingDirectory=/var/www/site
ExecStart=/usr/bin/docker exec -u www-data -w /var/www/site site-php php artisan schedule:run
